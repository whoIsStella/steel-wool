{
  "name": "steel-wool",
  "version": "0.2.0",
  "description": "Defensive privacy and network-safety prototype",
  "author": "Stella Parker",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:headless": "xvfb-run --auto-servernum --server-args='-screen 0 1024x768x24' electron --disable-gpu --no-sandbox .",
    "check": "node --check main.js && node --check preload.js && node --check renderer.js && node --check stealth.js && node --check tor-stealth.js",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.stellaparker.steelwool",
    "productName": "Steel Wool",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*"
    ],
    "publish": null,
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "puppeteer": "^25.1.0",
    "puppeteer-extra": "^3.3.4",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.8.1"
  }
}
